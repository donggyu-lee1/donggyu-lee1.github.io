---
const onHomePage = Astro.url.pathname === "/";
const homeAnchor = (id: string) => (onHomePage ? `#${id}` : `/#${id}`);
const writingActive = Astro.url.pathname.startsWith("/writing");
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={onHomePage ? "#top" : "/#top"} data-cursor="Top">Donggyu Lee</a>
    <nav class="site-nav" aria-label="Primary navigation">
      <a href={homeAnchor("work")} data-cursor="Go">Research</a>
      <a href={homeAnchor("experience")} data-cursor="Go">Experience</a>
      <a href="/writing/" aria-current={writingActive ? "page" : undefined} data-cursor="Read">Writing</a>
    </nav>
    <a class="header-hello" href="mailto:donggyu.lee@kaist.ac.kr" data-cursor="Email">Say hello <span aria-hidden="true">↗</span></a>
  </div>
</header>
