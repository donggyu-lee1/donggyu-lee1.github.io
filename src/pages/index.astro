---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts, getWritingUrl } from "../lib/writing";
import ResearchPaper from "../components/ResearchPaper.astro";
import { publications } from "../lib/research";
import { profileDescription, getProfileGraph } from "../lib/discovery";

interface Experience {
  id: string;
  org: string;
  role: string;
  period: string;
  location: string;
  teaser: string;
  description: string;
  tags: string[];
  award?: string;
}

const experiences: Experience[] = [
  {
    id: "stanford",
    org: "Stanford Doerr School of Sustainability",
    role: "Visiting Researcher",
    period: "Jul 2026",
    location: "Stanford, California",
    teaser: "Satellite crop mapping for low-resource regions",
    description: "Adapted and enhanced satellite-based crop classification methods for rice, maize, and other major crops, improving transferability and performance in data-scarce regions. The work was conducted with Prof. David Lobell and Prof. Jennifer Burney, in collaboration with the Ministry of Unification of the Republic of Korea.",
    tags: ["Satellite imagery", "Crop classification", "Low-resource regions"]
  },
  {
    id: "mpi",
    org: "Max Planck Institute for Security and Privacy",
    role: "Research Intern",
    period: "Aug — Dec 2025",
    location: "Bochum, Germany",
    teaser: "Satellite imagery + LLM/VLMs for socioeconomic estimation",
    description: "Estimated socioeconomic indicators using satellite imagery and large language and vision-language models, with applications spanning North Korea, other developing regions, and the Visegrád Group. Conducted in the Data Science for Humanity Group, advised by Prof. Meeyoung Cha.",
    tags: ["LLMs & VLMs", "Socioeconomic estimation", "Satellite imagery"]
  },
  {
    id: "samsung",
    org: "Samsung Electronics",
    role: "Machine Learning Engineer Intern",
    period: "Jan — Feb 2024",
    location: "Seoul–Incheon, Korea",
    teaser: "Synthetic defect images for Galaxy quality inspection",
    description: "Built a synthetic-data pipeline with Stable Diffusion and DreamBooth to generate smartphone defect images for Galaxy quality-inspection models and improve adaptation to new product launches. The project was conducted in Samsung Electronics Global Research’s Smart Factory Group.",
    tags: ["Stable Diffusion", "DreamBooth", "Computer vision"],
    award: "Best Internship Project Award"
  },
  {
    id: "aai",
    org: "KAIST Applied Artificial Intelligence Lab",
    role: "Undergraduate Researcher",
    period: "Mar — Jun 2024",
    location: "Daejeon, Korea",
    teaser: "Diffusion models from DDPM to Stable Diffusion",
    description: "Studied diffusion-based generative models through foundational work including DDPM, DDIM, and Stable Diffusion, then presented their methods and key ideas to the research group.",
    tags: ["DDPM", "DDIM", "Stable Diffusion"]
  },
  {
    id: "fel",
    org: "KAIST Financial Engineering Lab",
    role: "Undergraduate Researcher",
    period: "Dec 2020 — Feb 2021",
    location: "Daejeon, Korea",
    teaser: "Insurance rider recommendation with collaborative filtering",
    description: "Developed a prototype recommender system for a Korean financial company to recommend insurance riders from customer and product data, exploring collaborative filtering and matrix-factorization approaches such as SVD.",
    tags: ["Recommender systems", "Collaborative filtering", "SVD"]
  }
];

const latestPost = (await getPublishedPosts())[0];
const pageDescription = profileDescription;
---

<BaseLayout title="Donggyu Lee (이동규) | AI, Economics & Society · KAIST" description={pageDescription} structuredData={getProfileGraph()}>
  <main id="top" class="home-page">
    <div class="cursor-follower" aria-hidden="true"><span></span></div>
    <a class="skip-link" href="#about">Skip to content</a>

    <section class="home-hero shell" id="about">
      <div class="portrait-wrap" data-cursor="Hi!">
        <div class="portrait-blob" aria-hidden="true"></div>
        <picture>
          <source type="image/webp" srcset="/assets/profile-640.webp 640w, /assets/profile-960.webp 960w" sizes="(max-width: 650px) 78vw, 320px" />
          <img src="/assets/profile.jpg" alt="Donggyu Lee (이동규), Ph.D. student at KAIST" width="2072" height="2214" fetchpriority="high" decoding="async" />
        </picture>
        <span class="portrait-caption">Daejeon, Korea <b aria-hidden="true">●</b></span>
      </div>

      <div class="hero-copy">
        <p class="hello">Hi, I’m Donggyu Lee <span class="korean-name" lang="ko">이동규</span> <span aria-hidden="true">👋</span></p>
        <h1>AI for economic<br />and social questions.</h1>
        <p class="lead">Ph.D. student at KAIST Graduate School of Data Science, studying how AI systems reason about economic and social phenomena.</p>
        <p class="bio">I work across large language models, satellite imagery, and computational social science—especially when reliable data are scarce.</p>
        <p class="affiliation-line">At <a href="https://econai.kaist.ac.kr/" target="_blank" rel="noopener">econai@kaist ↗</a>, advised by <a href="https://jiheekim.net/" target="_blank" rel="noopener">Prof. Jihee Kim ↗</a>.</p>

        <div class="hero-buttons">
          <a class="home-button primary" href="/assets/CV_DonggyuLee.pdf?v=20261004" target="_blank" rel="noopener" data-cursor="Open CV">Curriculum Vitae <span aria-hidden="true">↗</span></a>
          <a class="home-button secondary" href="https://scholar.google.co.kr/citations?user=fp4h9-kAAAAJ&hl=en" target="_blank" rel="noopener" data-cursor="Scholar">Google Scholar <span aria-hidden="true">↗</span></a>
        </div>

        <div class="social-links" aria-label="Social links">
          <a href="mailto:donggyu.lee@kaist.ac.kr" data-cursor="Email">Email</a>
          <a href="https://github.com/donggyu-lee1" target="_blank" rel="noopener" data-cursor="GitHub">GitHub</a>
          <a href="https://www.linkedin.com/in/donggyu-lee-65784b21b" target="_blank" rel="noopener" data-cursor="LinkedIn">LinkedIn</a>
        </div>
      </div>
    </section>

    <aside class="home-news shell" aria-label="Latest update">
      <span aria-hidden="true">✨</span>
      <p><strong>Recently:</strong> Visiting research at Stanford Doerr on satellite crop mapping in data-scarce regions.</p>
      <a href="#experience" data-cursor="Details">More</a>
    </aside>

    <section class="research-themes shell" aria-labelledby="themes-title">
      <div class="theme-heading"><p class="section-kicker">Questions that guide my work</p><h2 id="themes-title">Two connected research themes.</h2></div>
      <div class="theme-grid">
        <a class="theme-card reasoning-theme" href="/research/#economic-reasoning"><span class="theme-index" aria-hidden="true">01 / Reasoning</span><h3>LLM reasoning in economics</h3><p>Can language models use economic evidence across contexts, and how does ideological bias affect their causal judgments?</p><span class="theme-link">Explore the research <span aria-hidden="true">↗</span></span></a>
        <a class="theme-card satellite-theme" href="/research/#satellite-society"><span class="theme-index" aria-hidden="true">02 / Measurement</span><h3>Satellite imagery &amp; society</h3><p>How can satellite imagery and machine learning help study economic and social conditions where direct measurements are limited?</p><span class="theme-link">Explore the research <span aria-hidden="true">↗</span></span></a>
      </div>
    </section>

    <section class="home-section shell" id="work">
      <div class="home-section-title-row">
        <div>
          <p class="section-kicker">Selected publications</p>
          <h2>Papers &amp; projects</h2>
          <a class="research-overview-link" href="/research/">All research &amp; resources <span aria-hidden="true">↗</span></a>
        </div>
        <div class="filter-buttons" aria-label="Filter publications">
          <button type="button" class="active" aria-pressed="true" data-filter="all" data-cursor="Filter">All</button>
          <button type="button" aria-pressed="false" data-filter="llm" data-cursor="Filter">LLM reasoning</button>
          <button type="button" aria-pressed="false" data-filter="geo" data-cursor="Filter">Satellite &amp; society</button>
        </div>
      </div>

      <div class="paper-list" aria-live="polite">
        {publications.map((paper) => <ResearchPaper paper={paper} />)}
      </div>
    </section>

    <section class="home-section experience-section shell" id="experience">
      <div class="home-section-title-row experience-heading">
        <div>
          <p class="section-kicker">Places I’ve learned from</p>
          <h2>Experience</h2>
        </div>
        <p>Hover for a quick hint. Click a place to see what I worked on.</p>
      </div>

      <div class="experience-list">
        {experiences.map((item) => (
          <article class="experience-item">
            <button type="button" aria-expanded="false" aria-controls={`experience-${item.id}`} data-experience-id={item.id} data-cursor="What I did">
              <time>{item.period}</time>
              <span class="experience-name"><strong>{item.org}</strong><small>{item.role}</small></span>
              <span class="experience-teaser">{item.teaser}</span>
              <span class="plus" aria-hidden="true">+</span>
            </button>
            <div class="experience-hover" aria-hidden="true">{item.teaser}</div>
            <div class="experience-detail" id={`experience-${item.id}`} hidden>
              <div>
                <p class="detail-label">What I worked on</p>
                <p>{item.description}</p>
                {item.award && <span class="award">🏆 {item.award}</span>}
              </div>
              <div class="detail-meta">
                <span>📍 {item.location}</span>
                <div>{item.tags.map((tag) => <span>{tag}</span>)}</div>
              </div>
            </div>
          </article>
        ))}
      </div>

      <p class="experience-source">Details follow my current LinkedIn profile. KAIST lab names use the labels from this website. <a href="https://www.linkedin.com/in/donggyu-lee-65784b21b" target="_blank" rel="noopener" data-cursor="LinkedIn">View profile ↗</a></p>
    </section>

    <section class="home-small-grid shell">
      <div class="home-small-card education-card">
        <span aria-hidden="true">🎓</span>
        <p class="section-kicker">Education</p>
        <h3>KAIST</h3>
        <p>Ph.D. Data Science · Sep 2026 – Present<br />M.S. Data Science · Sep 2024 – Aug 2026<br />B.S. Computer Science · Mar 2017 – Aug 2024<br />Economics minor</p>
        <small>Advisor: <a href="https://jiheekim.net/" target="_blank" rel="noopener">Prof. Jihee Kim ↗</a><br />Exchange at EPFL · Aug 2022 – Feb 2023</small>
      </div>
      {latestPost && (
        <a class="home-small-card writing-card-home" href={getWritingUrl(latestPost)} data-cursor="Read note">
          <span aria-hidden="true">✍️</span>
          <p class="section-kicker">Latest note</p>
          <h3>{latestPost.data.title}</h3>
          <p>{latestPost.data.description}</p>
          <strong>Read writing ↗</strong>
        </a>
      )}
    </section>
  </main>
  <noscript><style is:inline>.experience-detail[hidden]{display:grid}.plus{display:none}</style></noscript>
</BaseLayout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const paperRows = document.querySelectorAll<HTMLElement>("[data-paper-topic]");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const topic = button.dataset.filter;
      filterButtons.forEach((candidate) => {
        const active = candidate === button;
        candidate.classList.toggle("active", active);
        candidate.setAttribute("aria-pressed", String(active));
      });
      paperRows.forEach((row) => {
        row.hidden = topic !== "all" && row.dataset.paperTopic !== topic;
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-experience-id]").forEach((button) => {
    button.addEventListener("click", () => {
      const item = button.closest<HTMLElement>(".experience-item");
      const detail = document.getElementById(`experience-${button.dataset.experienceId}`);
      if (!item || !detail) return;
      const willOpen = button.getAttribute("aria-expanded") !== "true";

      document.querySelectorAll<HTMLButtonElement>("[data-experience-id]").forEach((candidate) => {
        const candidateItem = candidate.closest<HTMLElement>(".experience-item");
        const candidateDetail = document.getElementById(`experience-${candidate.dataset.experienceId}`);
        candidate.setAttribute("aria-expanded", "false");
        candidateItem?.classList.remove("open");
        if (candidateDetail) candidateDetail.hidden = true;
        const plus = candidate.querySelector<HTMLElement>(".plus");
        if (plus) plus.textContent = "+";
      });

      if (willOpen) {
        button.setAttribute("aria-expanded", "true");
        item.classList.add("open");
        detail.hidden = false;
        const plus = button.querySelector<HTMLElement>(".plus");
        if (plus) plus.textContent = "−";
      }
    });
  });

  const cursor = document.querySelector<HTMLElement>(".cursor-follower");
  if (cursor && !window.matchMedia("(pointer: coarse)").matches) {
    const label = cursor.querySelector<HTMLElement>("span");
    window.addEventListener("pointermove", (event) => {
      cursor.style.setProperty("--cursor-x", `${event.clientX}px`);
      cursor.style.setProperty("--cursor-y", `${event.clientY}px`);
      cursor.classList.add("is-visible");
    }, { passive: true });
    document.addEventListener("pointerover", (event) => {
      const target = (event.target as Element | null)?.closest<HTMLElement>("[data-cursor]");
      if (target) {
        if (label) label.textContent = target.dataset.cursor ?? "Open";
        cursor.classList.add("is-active");
      } else {
        if (label) label.textContent = "";
        cursor.classList.remove("is-active");
      }
    }, { passive: true });
    document.documentElement.addEventListener("mouseleave", () => cursor.classList.remove("is-visible", "is-active"));
  }
</script>
